    "#### Model Evaluation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 86,
   "id": "2a06f889",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Evaluate on training set\n",
    "y_train_pred = best_model.predict(X_train_resampled)\n",
    "y_train_prob = best_model.predict_proba(X_train_resampled)[:, 1]\n",
    "\n",
    "train_auc = roc_auc_score(y_train_resampled, y_train_prob)\n",
    "train_f1 = f1_score(y_train_resampled, y_train_pred)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 87,
   "id": "dedf75c8",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Evaluate on test set\n",
    "y_test_pred = best_model.predict(X_test_scaled)\n",
    "y_test_prob = best_model.predict_proba(X_test_scaled)[:, 1]\n",
    "\n",
    "test_auc = roc_auc_score(y_test, y_test_prob)\n",
    "test_f1 = f1_score(y_test, y_test_pred)"
